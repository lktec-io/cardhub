# CardHub API — copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4006

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cardhub
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cloudinary — customer-uploaded images only (services/providers/imageStorageProvider.js).
# Backend-only; the API secret is never sent to, or reachable from, React.
# Leaving these unset makes uploads honestly report "not connected yet"
# rather than faking a successful upload. See docs/architecture.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reserved — no email provider is connected. Leaving these unset makes
# services/providers/emailProvider.js report delivery as "unavailable"
# rather than pretending to send. See docs/architecture.md.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Beem (beem.africa) — CardHub's chosen SMS provider (services/providers/smsProvider.js).
# api_key/secret_key are Beem's Basic Auth credential pair. Backend-only.
# BEEM_SENDER_ID is the registered Beem sender name, e.g. "Clix Invite".
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=

# WhatsApp — services/providers/whatsappProvider.js.
#
# Beem approved-template sending (CardHub's invitation channel). Invitations
# are a first contact, so WhatsApp only allows an approved TEMPLATE; the six
# template variables are sent in this order: guest name, event name, event
# date, event time, venue, invitation URL (template "KADI YA MWALIKO").
# Setting BEEM_WHATSAPP_API_URL selects Beem automatically; if you also set
# WHATSAPP_PROVIDER it must be "beem". Check with: npm run whatsapp:test
BEEM_WHATSAPP_API_URL=
BEEM_WHATSAPP_API_KEY=
BEEM_WHATSAPP_API_SECRET=
BEEM_WHATSAPP_FROM=
# Beem's template id for "KADI YA MWALIKO" on the BEEM_WHATSAPP_FROM sender (find it with: npm run whatsapp:test -- --templates)
BEEM_WHATSAPP_TEMPLATE_ID=
# Informational: the language is fixed by Beem/Meta with the template id.
BEEM_WHATSAPP_TEMPLATE_LANGUAGE=
# Delivery reports: point Beem at <API_URL>/webhooks/beem/whatsapp?secret=<BEEM_WHATSAPP_CALLBACK_SECRET>
BEEM_WHATSAPP_CALLBACK_URL=
BEEM_WHATSAPP_CALLBACK_SECRET=
# basic (Authorization: Basic key:secret) or token (Authorization: <token>, no "Bearer" prefix, per Beem docs)
BEEM_WHATSAPP_AUTH_MODE=basic
BEEM_WHATSAPP_RATE_PER_SECOND=5
BEEM_WHATSAPP_TIMEOUT_MS=15000
#
# Alternative transport: the official Meta WhatsApp Cloud API. Only set
# WHATSAPP_PROVIDER=meta if you are NOT using the Beem template above.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Until these are set, WHATSAPP_PROVIDER stays effectively unconfigured
# and every WhatsApp send honestly reports "unavailable" — it never fakes
# a successful send. SMS (above) is fully independent and works without
# any of this being set.

# Payments (Phase 3) — services/providers/paymentProvider.js. Reuses the
# same Beem account/keys as SMS above (BEEM_API_KEY/BEEM_SECRET_KEY) —
# only PAYMENT_PROVIDER needs setting once you have Beem's real
# collection-initiation endpoint/payload documented (see the provider
# file's comment — this is deliberately NOT fabricated). Until then,
# checkout honestly reports "unavailable" and never fakes a charge.
PAYMENT_PROVIDER=
# Shared secret CardHub expects back on the payment webhook (as an
# `x-webhook-secret` header or `?secret=` query param) — confirm the real
# mechanism against Beem's onboarding docs; this is a safe minimum-viable
# default, not a guess at Beem's exact scheme.
PAYMENT_WEBHOOK_SECRET=
# The callback/webhook URL you register with the payment provider, e.g.
#   https://cardhub.co.tz/api/v1/payments/webhook
PAYMENT_CALLBACK_URL=

# Ticket sales payment mode — services/providers/paymentGateway.js.
#   demo — DEMO PAYMENT MODE: simulated confirmation, no money moves,
#          tickets are flagged as demo tickets.
#   live — uses PAYMENT_PROVIDER above (reports "unavailable" until a real
#          gateway is wired in; only its verified webhook can mark PAID).
# Unset = demo in development, live in production. Set it to demo on the
# production server only if you deliberately want the public demo flow.
TICKET_PAYMENT_MODE=

# Local development defaults shown below. In production, set both to the
# real CardHub domain instead:
#   FRONTEND_URL=https://cardhub.co.tz
#   API_URL=https://cardhub.co.tz/api/v1
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4006/api/v1

# Admin-uploaded media (card images, event posters, event videos) — stored
# on this server's disk by services/providers/mediaStorage.js and served at
# <API_URL>/media/... In production point this at a persistent directory
# OUTSIDE the deploy folder (e.g. /var/lib/cardhub/media) so redeploys never
# delete uploads, and include it in backups. Defaults to backend/storage/media.
MEDIA_ROOT=
